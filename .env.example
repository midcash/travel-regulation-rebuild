# Copy to .env and set your key locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Retained Python Trace asset; not connected to Durable.
# Optional OTLP HTTP traces endpoint, e.g. http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Retained supplier assets; not connected to Durable
TUNIU_API_KEY=
TUNIU_FLIGHT_URL=https://openapi.tuniu.cn/mcp/flight
TUNIU_TRAIN_URL=https://openapi.tuniu.cn/mcp/train
AMAP_API_KEY=
