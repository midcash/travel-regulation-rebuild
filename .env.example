# Copy to .env and set your key locally. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional USD prices per 1M tokens; leave blank to show unknown cost.
# Set all three from your actual billing schedule, including cache-hit pricing.
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_CACHE_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=

OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional OTLP HTTP traces endpoint, e.g. http://127.0.0.1:4318/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=

# Main-project read-only supplier configuration
TUNIU_API_KEY=
TUNIU_FLIGHT_URL=https://openapi.tuniu.cn/mcp/flight
TUNIU_TRAIN_URL=https://openapi.tuniu.cn/mcp/train
